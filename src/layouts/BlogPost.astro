---
// src/layouts/BlogPost.astro
// Layout autossuficiente para as matérias do blog da SEG.
// Não importa nenhum componente existente — pode ser plugado no repo sem risco de quebrar o build.
// Para integrar com o header/footer reais do site, veja o comentário marcado com [INTEGRAÇÃO].

const { frontmatter } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  image,
  imageAlt,
  readingTime,
  author = "SEG Instalações",
} = frontmatter;

const site = "https://seginstalacoes.com.br";
const canonical = new URL(Astro.url.pathname, site).href;

const fmt = (d) =>
  new Date(d).toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric" });

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  image: image ? new URL(image, site).href : undefined,
  datePublished: pubDate,
  dateModified: updatedDate || pubDate,
  author: { "@type": "Organization", name: "SEG Instalações", url: site },
  publisher: {
    "@type": "Organization",
    name: "SEG Instalações",
    logo: { "@type": "ImageObject", url: `${site}/logo.png` },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Blog SEG Instalações</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, site).href} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <!-- [INTEGRAÇÃO] Se quiser o header real do site aqui, me avise que eu troco este bloco
         por <Header /> importado de src/components/. Deixei um topo mínimo pra não depender
         de nada que eu não tenha visto no repo. -->
    <header class="topbar">
      <a class="brand" href="/">SEG<span>.</span></a>
      <nav>
        <a href="/servicos">Serviços</a>
        <a href="/projetos">Projetos</a>
        <a href="/blog" aria-current="page">Blog</a>
        <a class="cta" href="/contato">Solicitar orçamento</a>
      </nav>
    </header>

    <main>
      <article class="post">
        <div class="post-head">
          <a class="back" href="/blog">← Todas as matérias</a>
          <p class="eyebrow">{category}</p>
          <h1>{title}</h1>
          <p class="lede">{description}</p>
          <div class="meta">
            <span>{author}</span>
            <span class="dot" aria-hidden="true">·</span>
            <time datetime={pubDate}>{fmt(pubDate)}</time>
            {readingTime && (
              <>
                <span class="dot" aria-hidden="true">·</span>
                <span>{readingTime} min de leitura</span>
              </>
            )}
          </div>
        </div>

        {image && (
          <figure class="hero-figure">
            <img src={image} alt={imageAlt} loading="eager" decoding="async" />
          </figure>
        )}

        <div class="prose">
          <slot />
        </div>

        <aside class="cta-block">
          <p class="eyebrow">SEG Instalações</p>
          <h2>Quer esse projeto bem feito desde a primeira parede?</h2>
          <p>
            Automação, CFTV, controle de acesso, rede e som ambiente num projeto só — em Ilhéus,
            Itabuna, Itacaré e região.
          </p>
          <a class="cta" href="/contato">Falar com um especialista</a>
        </aside>
      </article>
    </main>

    <footer class="foot">
      <p>SEG Instalações · Tecnologia · Segurança · Infraestrutura</p>
      <p class="muted">Tudo conectado. Tudo sob controle.</p>
    </footer>

    <style is:global>
      :root {
        --seg-bg: #070d18;
        --seg-surface: #0c1526;
        --seg-line: #1b2942;
        --seg-navy: #00265f;
        --seg-orange: #e85a1a;
        --seg-text: #e8edf5;
        --seg-muted: #8da0bc;
        --seg-dim: #6f82a0;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--seg-bg);
        color: var(--seg-text);
        font-family: "Poppins", system-ui, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--seg-orange); outline-offset: 3px; border-radius: 4px; }

      .topbar {
        display: flex; align-items: center; justify-content: space-between;
        gap: 24px; padding: 20px clamp(20px, 5vw, 64px);
        border-bottom: 1px solid var(--seg-line);
        position: sticky; top: 0; z-index: 10;
        background: rgba(7, 13, 24, 0.86); backdrop-filter: blur(10px);
      }
      .brand { font-weight: 700; letter-spacing: 0.08em; text-decoration: none; font-size: 22px; }
      .brand span { color: var(--seg-orange); }
      .topbar nav { display: flex; align-items: center; gap: 28px; }
      .topbar nav a { text-decoration: none; font-size: 14px; font-weight: 500; color: var(--seg-muted); }
      .topbar nav a:hover, .topbar nav a[aria-current] { color: var(--seg-text); }
      .cta {
        background: var(--seg-orange); color: #070d18 !important;
        padding: 10px 18px; border-radius: 999px;
        font-weight: 600; text-decoration: none; font-size: 14px;
        transition: transform 0.2s ease, filter 0.2s ease;
      }
      .cta:hover { filter: brightness(1.08); transform: translateY(-1px); }
      @media (max-width: 720px) { .topbar nav a:not(.cta) { display: none; } }

      main { padding: clamp(40px, 6vw, 80px) clamp(20px, 5vw, 64px); }
      .post { max-width: 780px; margin: 0 auto; }

      .back { font-size: 13px; color: var(--seg-dim); text-decoration: none; }
      .back:hover { color: var(--seg-orange); }
      .eyebrow {
        margin: 28px 0 12px; font-size: 12px; font-weight: 700;
        letter-spacing: 0.16em; text-transform: uppercase; color: var(--seg-orange);
      }
      .post h1 {
        margin: 0 0 20px; font-size: clamp(30px, 5vw, 46px);
        line-height: 1.14; font-weight: 700; letter-spacing: -0.02em;
      }
      .lede { margin: 0 0 24px; font-size: clamp(17px, 2vw, 19px); line-height: 1.6; color: var(--seg-muted); }
      .meta { display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; color: var(--seg-dim); }
      .dot { color: var(--seg-line); }

      .hero-figure { margin: 40px 0; }
      .hero-figure img, .prose img {
        width: 100%; height: auto; display: block;
        border: 1px solid var(--seg-line); border-radius: 14px; background: var(--seg-surface);
      }

      .prose { font-size: 17px; line-height: 1.75; color: #cfdae9; }
      .prose h2 {
        margin: 56px 0 16px; font-size: clamp(23px, 3vw, 29px);
        line-height: 1.25; color: var(--seg-text); letter-spacing: -0.01em;
        padding-left: 16px; border-left: 3px solid var(--seg-orange);
      }
      .prose h3 { margin: 36px 0 12px; font-size: 19px; color: var(--seg-text); }
      .prose p { margin: 0 0 20px; }
      .prose strong { color: var(--seg-text); font-weight: 600; }
      .prose ul, .prose ol { margin: 0 0 20px; padding-left: 22px; }
      .prose li { margin-bottom: 10px; }
      .prose li::marker { color: var(--seg-orange); }
      .prose a { color: var(--seg-orange); text-decoration: underline; text-underline-offset: 3px; }
      .prose figure { margin: 40px 0; }
      .prose figcaption { margin-top: 12px; font-size: 13px; color: var(--seg-dim); text-align: center; }
      .prose blockquote {
        margin: 32px 0; padding: 20px 24px;
        background: var(--seg-surface); border: 1px solid var(--seg-line);
        border-left: 3px solid var(--seg-orange); border-radius: 0 12px 12px 0;
        font-size: 17px; color: var(--seg-text);
      }
      .prose blockquote p:last-child { margin-bottom: 0; }
      .prose table { width: 100%; border-collapse: collapse; margin: 32px 0; font-size: 15px; }
      .prose th, .prose td { padding: 14px 12px; text-align: left; border-bottom: 1px solid var(--seg-line); vertical-align: top; }
      .prose th { color: var(--seg-orange); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
      .prose hr { border: 0; border-top: 1px solid var(--seg-line); margin: 48px 0; }

      .cta-block {
        margin-top: 72px; padding: 40px; border-radius: 18px;
        background: linear-gradient(140deg, #0d1a33 0%, var(--seg-surface) 70%);
        border: 1px solid var(--seg-line);
      }
      .cta-block h2 { margin: 0 0 12px; font-size: 25px; line-height: 1.3; }
      .cta-block p { margin: 0 0 24px; color: var(--seg-muted); font-size: 16px; line-height: 1.6; }
      .cta-block .cta { display: inline-block; }

      .foot {
        border-top: 1px solid var(--seg-line);
        padding: 40px clamp(20px, 5vw, 64px);
        font-size: 13px; color: var(--seg-dim);
      }
      .foot p { margin: 0 0 6px; }
      .foot .muted { color: var(--seg-line); }

      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
      }
    </style>
  </body>
</html>
