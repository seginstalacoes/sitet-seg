---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsFloat from '../components/WhatsFloat.astro';
import { SITE, WA_PADRAO } from '../data/site.js';

const {
  title,
  description,
  waMsg = WA_PADRAO,
  schema = null
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\.html$/, '');

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: SITE.nome,
  slogan: SITE.slogan,
  taxID: SITE.cnpj,
  url: 'https://seginstalacoes.com.br',
  email: SITE.email,
  telephone: '+55-73-3017-5350',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rua Visconde de Mauá, 235',
    addressLocality: 'Ilhéus',
    addressRegion: 'BA',
    postalCode: '45652-042',
    addressCountry: 'BR'
  },
  areaServed: ['Ilhéus', 'Itabuna', 'Itacaré', 'Barra Grande', 'Una', 'Canavieiras'],
  sameAs: [SITE.instagram]
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema ?? localBusiness)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Ir para o conteúdo</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <WhatsFloat msg={waMsg} />
    <style>
      .skip { position: absolute; left: -9999px; background: var(--orange); color: #fff; padding: 10px 16px; border-radius: 8px; z-index: 100; }
      .skip:focus { left: 12px; top: 12px; }
    </style>
  </body>
</html>
