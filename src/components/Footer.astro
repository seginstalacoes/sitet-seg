---
import { SITE, waLink, WA_PADRAO } from '../data/site.js';
---
<footer class="ftr">
  <div class="wrap grid grid-3">
    <div>
      <img src="/logos/seg-logo-negativa.svg" alt="SEG Instalações" width="188" height="62" style="height:62px;width:auto;margin-bottom:16px" />
      <p>Automação e integração de sistemas no sul da Bahia.</p>
      <p>CNPJ {SITE.cnpj}</p>
      <p>{SITE.endereco}</p>
    </div>
    <div>
      <p class="fh">Contato</p>
      <p><a href={`tel:+557330175350`}>{SITE.foneFixo}</a> · <a href={waLink(WA_PADRAO)} rel="noopener">{SITE.foneMovel} (WhatsApp)</a></p>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p><a href={SITE.instagram} rel="noopener" class="ig-link" aria-label="Instagram da SEG Instalações">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        @seg_instalacoes</a></p>
      <p>Atendemos {SITE.cidades}.</p>
    </div>
    <div>
      <p class="fh">Institucional</p>
      <p><a href="/empresa">Empresa</a> · <a href="/como-trabalhamos">Como trabalhamos</a></p>
      <p><a href="/servicos">Serviços</a> · <a href="/segmentos">Segmentos</a> · <a href="/projetos">Projetos</a> · <a href="/blog">Blog</a></p>
      <p><a href="/downloads">Downloads</a> · <a href="/loja">Loja</a></p>
      <p><a href="/politica-de-privacidade">Privacidade e LGPD</a> · <a href="/termos-de-uso">Termos de uso</a></p>
    </div>
  </div>
  <div class="wrap base">
    <p>© {new Date().getFullYear()} SEG Instalações — {SITE.slogan}</p>
  </div>
</footer>
<style>
.ftr { background: var(--navy-deep); color: #C7D3E8; padding: 56px 0 0; font-size: .93rem; }
.ftr a { color: #fff; text-decoration: none; }
.ftr a:hover { color: var(--orange); }
.ftr p { margin: 0 0 8px; }
.fh { color: #fff; font-weight: 700; margin-bottom: 12px; font-size: 1rem; }
.base { border-top: 1px solid rgba(255,255,255,.12); margin-top: 40px; padding-top: 18px; padding-bottom: 18px; }
.base p { color: #8FA3C4; font-size: .85rem; }
</style>
