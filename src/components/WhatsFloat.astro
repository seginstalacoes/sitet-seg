---
import { waLink } from '../data/site.js';
import Icon from './Icon.astro';
const { msg } = Astro.props;
---
<a class="wa-float" href={waLink(msg)} rel="noopener" aria-label="Falar com a SEG no WhatsApp">
  <Icon name="wa" size={28} />
</a>
<style>
.wa-float { position: fixed; right: 20px; bottom: 20px; z-index: 60; width: 58px; height: 58px; border-radius: 50%;
  background: #25D366; color: #fff; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6px 20px rgba(0,0,0,.25); transition: transform .15s ease; }
.wa-float:hover { transform: scale(1.07); }
</style>
