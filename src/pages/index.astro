---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MediaPh from '../components/MediaPh.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { waLink, WA_PADRAO, SITE } from '../data/site.js';

const servicos = (await getCollection('servicos')).sort((a, b) => a.data.order - b.data.order);
const destaque = servicos.filter(s => s.data.destaque);
const integraveis = servicos.filter(s => !s.data.destaque);
const segmentos = (await getCollection('segmentos')).sort((a, b) => a.data.order - b.data.order);

const etapas = ['Levantamento técnico', 'Projeto', 'Instalação', 'Configuração', 'Testes', 'Entrega e treinamento', 'Manutenção'];
---
<Base
  title="Automação Residencial e Integração de Sistemas em Ilhéus e Sul da Bahia | SEG Instalações"
  description="Automação residencial, CFTV, controle de acesso, redes e som ambiente funcionando como um só sistema. Projeto com responsabilidade técnica de engenharia. Peça um orçamento."
  waMsg={WA_PADRAO}
>
  <!-- HERO cinematográfico -->
  <section class="hero">
    <video class="hero-bg" autoplay muted loop playsinline preload="metadata"
      poster="/fotos/conceito/conceito-residencia.webp"
      aria-hidden="true">
      <source src="/videos/hero-institucional.mp4" type="video/mp4" />
    </video>
    <div class="hero-veil"></div>
    <div class="wrap hero-inner">
      <span class="eyebrow">Automação e integração de sistemas · Sul da Bahia</span>
      <h1>Tudo conectado<span class="dot">.</span><br />Tudo sob controle<span class="dot">.</span></h1>
      <p class="lead">
        Iluminação, segurança, som, acesso e redes funcionando como um só sistema —
        com projeto e responsabilidade técnica de engenharia.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/orcamento">Solicitar orçamento</a>
        <a class="btn btn-ghost-light" href={waLink(WA_PADRAO)} rel="noopener">Falar no WhatsApp</a>
      </div>
      <div class="hero-chips">
        <span>Parceiros Intelbras &amp; Hikvision</span>
        <span>Direção técnica de engenharia</span>
        <span>+600 projetos no sul da Bahia</span>
      </div>
    </div>
  </section>

  <!-- INDICADORES -->
  <section class="section" style="padding-top:44px;padding-bottom:44px">
    <div class="wrap stats" id="stats">
      <div class="stat"><b>+<span class="count" data-alvo="10">0</span> anos</b><span>de mercado</span></div>
      <div class="stat"><b>+<span class="count" data-alvo="600">0</span></b><span>projetos executados</span></div>
      <div class="stat"><b>+<span class="count" data-alvo="3000" data-fmt="mil">0</span></b><span>câmeras instaladas</span></div>
      <div class="stat"><b>Engenharia</b><span>direção técnica</span></div>
    </div>
    <script>
      const mReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const fmt = (n, f) => f === 'mil' ? n.toLocaleString('pt-BR') : String(n);
      const els = document.querySelectorAll('.count');
      if (mReduce) { els.forEach(e => e.textContent = fmt(+e.dataset.alvo, e.dataset.fmt)); }
      else {
        const io = new IntersectionObserver((ents) => ents.forEach(ent => {
          if (!ent.isIntersecting) return;
          io.unobserve(ent.target);
          const alvo = +ent.target.dataset.alvo, f = ent.target.dataset.fmt, t0 = performance.now();
          const tick = (t) => {
            const p = Math.min((t - t0) / 1400, 1);
            ent.target.textContent = fmt(Math.round(alvo * (1 - Math.pow(1 - p, 3))), f);
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }), { threshold: 0.4 });
        els.forEach(e => io.observe(e));
      }
    </script>
  </section>

  <!-- O QUE FAZEMOS -->
  <section class="section alt">
    <div class="wrap">
      <div class="sec-banner"><span class="num">01</span><h2>Sua casa e sua empresa, funcionando como um só sistema</h2></div>
      <p class="lead">
        A SEG Instalações é uma integradora de tecnologia. Projetamos, instalamos e configuramos
        automação, segurança eletrônica, redes e áudio — e fazemos tudo isso conversar em uma única
        plataforma, no seu celular.
      </p>
      <p class="lead" style="margin-top:14px">
        Quem já instalou mais de 3.000 câmeras conhece infraestrutura como poucos. É essa base que
        sustenta nossos projetos de automação: cabeamento certo, rede estável e sistemas que
        continuam funcionando anos depois da entrega.
      </p>
    </div>
  </section>

  <!-- SOLUÇÕES -->
  <section class="section">
    <div class="wrap">
      <div class="sec-banner"><span class="num">02</span><h2>Soluções</h2></div>
      <div class="grid grid-3">
        {destaque.map(s => (
          <a class="card destaque" href={`/servicos/${s.id}`}>
            <div class="ico"><Icon name={s.data.icon} /></div>
            <h3>{s.data.title}</h3>
            <p>{s.data.resumo}</p>
          </a>
        ))}
      </div>
      <p class="sub-label">Sistemas integráveis</p>
      <div class="grid grid-4">
        {integraveis.map(s => (
          <a class="card" href={`/servicos/${s.id}`}>
            <div class="ico"><Icon name={s.data.icon} size={26} /></div>
            <h3 style="font-size:1.02rem">{s.data.title}</h3>
            <p style="font-size:.9rem">{s.data.resumo}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SEGMENTOS -->
  <section class="section alt">
    <div class="wrap">
      <div class="sec-banner"><span class="num">03</span><h2>Soluções para cada perfil</h2></div>
      <div class="grid grid-3">
        {segmentos.map(s => (
          <a class="card" href={`/segmentos/${s.id}`}>
            <div class="ico"><Icon name={s.data.icon} /></div>
            <h3>{s.data.title}</h3>
            <p>{s.data.resumo}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MÉTODO -->
  <section class="section">
    <div class="wrap">
      <div class="sec-banner"><span class="num">04</span><h2>Como trabalhamos</h2></div>
      <ol class="etapas">
        {etapas.map((e, i) => (
          <li><span class="et-num">{String(i + 1).padStart(2, '0')}</span>{e}</li>
        ))}
      </ol>
      <p style="margin-top:22px"><a class="btn btn-ghost" href="/como-trabalhamos">Conheça o método SEG</a></p>
    </div>
  </section>

  <!-- PROJETOS -->
  <section class="section alt">
    <div class="wrap">
      <div class="sec-banner"><span class="num">05</span><h2>Projetos em destaque</h2></div>
      <div class="grid grid-3">
        <a class="card case-mini" href="/projetos/cftv-corporativo">
          <img class="case-foto" src="/fotos/02_cftv_camera_orla.webp" alt="Videomonitoramento corporativo — projeto SEG" loading="lazy" />
          <div class="case-mini-body"><h3>Videomonitoramento corporativo</h3><p>Empresas · Ilhéus/BA</p></div>
        </a>
        <a class="card case-mini" href="/projetos/seguranca-condominio">
          <img class="case-foto" src="/fotos/01_cftv_camera_hikvision.webp" alt="Segurança em condomínio — projeto SEG" loading="lazy" />
          <div class="case-mini-body"><h3>Prevenção em condomínio</h3><p>Condomínios · Ilhéus/BA</p></div>
        </a>
        <a class="card case-mini" href="/projetos/residencia-inteligente">
          <img class="case-foto" src="/fotos/08_iluminacao_cortinas_pendente.webp" alt="Residência inteligente — projeto SEG" loading="lazy" />
          <div class="case-mini-body"><h3>Residência inteligente</h3><p>Residências · Litoral sul</p></div>
        </a>
      </div>
      <p style="margin-top:24px"><a class="btn btn-ghost" href="/projetos">Ver todos os projetos</a></p>
      <div class="grid grid-3" style="margin-top:26px">
        <blockquote class="depo">"[DEPOIMENTO 1 — coletar com cliente empresarial]"<footer>— Cliente, Empresa</footer></blockquote>
        <blockquote class="depo">"[DEPOIMENTO 2 — coletar com síndico]"<footer>— Síndico, Condomínio</footer></blockquote>
        <blockquote class="depo">"[DEPOIMENTO 3 — coletar com cliente residencial]"<footer>— Cliente residencial</footer></blockquote>
      </div>
    </div>
  </section>

  <!-- PARCEIROS -->
  <section class="section" style="padding-top:48px;padding-bottom:48px">
    <div class="wrap">
      <div class="sec-banner"><span class="num">06</span><h2>Parceiros e marcas</h2></div>
      <div class="marquee" aria-label="Marcas parceiras">
        <div class="marcas track">
          <img src="/logos/parceiros/intelbras.png" alt="Intelbras" loading="lazy" />
          <img src="/logos/parceiros/hikvision.png" alt="Hikvision" loading="lazy" />
          <img src="/logos/parceiros/ambiente-g3.png" alt="Ambiente G3 — Cortinas Motorizadas" loading="lazy" />
          <img src="/logos/parceiros/quero-automacao.png" alt="Quero Automação" loading="lazy" />
          <img src="/logos/parceiros/frahm.png" alt="Frahm" loading="lazy" />
          <img src="/logos/parceiros/ubiquiti.png" alt="Ubiquiti Networks" loading="lazy" />
          <img src="/logos/parceiros/intelbras.png" alt="" aria-hidden="true" loading="lazy" />
          <img src="/logos/parceiros/hikvision.png" alt="" aria-hidden="true" loading="lazy" />
          <img src="/logos/parceiros/ambiente-g3.png" alt="" aria-hidden="true" loading="lazy" />
          <img src="/logos/parceiros/quero-automacao.png" alt="" aria-hidden="true" loading="lazy" />
          <img src="/logos/parceiros/frahm.png" alt="" aria-hidden="true" loading="lazy" />
          <img src="/logos/parceiros/ubiquiti.png" alt="" aria-hidden="true" loading="lazy" />
        </div>
      </div>
      <p style="color:var(--slate)">Equipamentos homologados, com garantia de fábrica e suporte oficial.</p>
    </div>
  </section>

  <!-- FAQ RESUMIDA -->
  <section class="section alt">
    <div class="wrap">
      <div class="sec-banner"><span class="num">07</span><h2>Perguntas frequentes</h2></div>
      <details><summary>Quanto custa um projeto de automação?</summary><p>Depende dos ambientes e sistemas envolvidos. Projetos modulares começam pelo essencial e crescem por etapas — e o orçamento é gratuito.</p></details>
      <details><summary>Vocês atendem quais cidades?</summary><p>{SITE.cidades} — e projetos fora da região mediante consulta.</p></details>
      <details><summary>Casa pronta pode ser automatizada?</summary><p>Sim. Usamos tecnologias sem fio confiáveis que dispensam quebra de acabamento.</p></details>
      <details><summary>Vocês dão garantia?</summary><p>Equipamentos têm garantia de fábrica (trabalhamos com marcas homologadas) e os serviços têm garantia SEG.</p></details>
      <p style="margin-top:16px"><a href="/perguntas-frequentes">Ver todas as perguntas →</a> · Não achou sua dúvida? <a href={waLink('Olá! Tenho uma dúvida que não encontrei no site da SEG.')} rel="noopener">Chama a gente no WhatsApp</a>.</p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
.hero { position: relative; overflow: hidden; background: var(--navy-deep); }
.hero-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; display: block; background: url('/fotos/conceito/conceito-residencia.webp') center / cover no-repeat; }
.hero-veil { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(100deg, rgba(6,17,39,0.94) 30%, rgba(6,17,39,0.55) 65%, rgba(6,17,39,0.35) 100%); }
.hero-inner { position: relative; z-index: 1; width: 100%; padding-top: 150px; padding-bottom: 130px; }
.hero h1 { color: #fff; margin: 0 0 20px; font-size: clamp(2.4rem, 5.5vw, 4rem); }
.hero .dot { color: var(--orange); }
.hero .lead { color: #C9D6EA; margin-bottom: 34px; max-width: 46ch; font-size: 1.2rem; }
.hero .eyebrow { color: var(--orange); }
.hero-chips { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 26px; }
.hero-chips span { font-size: .8rem; color: #C9D6EA; border: 1px solid rgba(255,255,255,.22); border-radius: 20px; padding: 6px 14px; }
@media (max-width: 880px) { .hero-inner { padding-top: 90px; padding-bottom: 80px; } }
.case-foto { width: 100%; height: 230px; object-fit: cover; }
.case-mini { padding: 0; overflow: hidden; }
.case-mini-body { padding: 18px 20px; }
.case-mini-body p { font-size: .85rem; color: var(--orange); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
.card.destaque { border-top: 4px solid var(--orange); }
.sub-label { color: var(--orange); font-size: .8rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; margin: 34px 0 14px; }
.etapas { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; counter-reset: none; }
.etapas li { background: rgba(255,255,255,0.04); border: 1px solid var(--line); border-radius: 8px; padding: 16px 14px; font-weight: 700; color: #fff; font-size: .92rem; }
.et-num { display: block; color: var(--orange); font-size: .85rem; margin-bottom: 6px; }
.depo { background: rgba(255,255,255,0.03); border: 1px solid var(--line); border-left: 3px solid var(--orange); border-radius: var(--radius); padding: 20px; color: var(--slate); font-size: .95rem; }
.depo footer { margin-top: 10px; font-weight: 700; color: #fff; font-style: normal; }
.marquee { overflow: hidden; margin-bottom: 18px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
.marcas.track { display: flex; gap: 56px; align-items: center; width: max-content; animation: rolar 28s linear infinite; }
.marquee:hover .track { animation-play-state: paused; }
@keyframes rolar { to { transform: translateX(-50%); } }
.marcas { display: flex; gap: 40px; flex-wrap: wrap; align-items: center; margin-bottom: 18px; }
.marcas img { height: 38px; width: auto; filter: brightness(0) invert(1); opacity: .75; transition: opacity .2s; }
.marcas img:hover { opacity: 1; }
@media (max-width: 720px) { .marcas { gap: 24px; } .marcas img { height: 30px; } }
</style>
