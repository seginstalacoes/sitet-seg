---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada | SEG Instalações" description="A página que você procura não existe ou mudou de endereço.">
  <section class="section" style="text-align:center;padding:110px 0">
    <div class="wrap">
      <h1>Página não encontrada</h1>
      <p class="lead" style="margin:14px auto 30px">O endereço mudou ou não existe. O caminho de volta está logo abaixo.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn-navy" href="/">Ir para a Home</a>
        <a class="btn btn-primary" href="/orcamento">Solicitar orçamento</a>
      </div>
    </div>
  </section>
</Base>
