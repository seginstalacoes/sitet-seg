---
import Base from '../layouts/Base.astro';
import { SITE, waLink, WA_PADRAO } from '../data/site.js';
const mapsEmbed = `https://www.google.com/maps?q=${encodeURIComponent(SITE.mapsQuery)}&output=embed`;
const mapsRota = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(SITE.mapsQuery)}`;
---
<Base title="Contato — Fale com a SEG Instalações em Ilhéus | SEG Instalações"
  description="Telefone (73) 3017-5350, WhatsApp (73) 99152-5743, e-mail contato@seginstalacoes.com.br. Rua Visconde de Mauá, 235 — Centro, Ilhéus/BA.">
  <section class="page-hero"><div class="wrap"><span class="eyebrow">Contato</span><h1>Fale com a SEG</h1></div></section>
  <section class="section"><div class="wrap grid grid-2">
    <div>
      <ul class="zebra" style="margin-bottom:26px">
        <li><strong>Telefone:</strong> <a href="tel:+557330175350">{SITE.foneFixo}</a></li>
        <li><strong>WhatsApp:</strong> <a href={waLink(WA_PADRAO)} rel="noopener">{SITE.foneMovel}</a></li>
        <li><strong>E-mail:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><strong>Endereço:</strong> {SITE.endereco}</li>
        <li><strong>Horário:</strong> segunda a sexta, das 8h às 18h</li>
        <li><strong>Instagram:</strong> <a href={SITE.instagram} rel="noopener">@seginstalacoes</a></li>
      </ul>
      <div class="btn-row">
        <a class="btn btn-primary" href="/orcamento">Solicitar orçamento</a>
        <a class="btn btn-ghost" href={mapsRota} rel="noopener">Como chegar</a>
      </div>
      <h2 style="margin-top:44px;font-size:1.2rem">Trabalhe conosco e parcerias</h2>
      <p style="color:var(--slate);max-width:60ch">Quer fazer parte da equipe ou propor uma parceria comercial? Envie um e-mail para <a href={`mailto:${SITE.email}`}>{SITE.email}</a> com o assunto "Trabalhe conosco" ou "Parceria".</p>
    </div>
    <div>
      <iframe src={mapsEmbed} width="100%" height="380" style="border:0;border-radius:10px" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Mapa — localização da SEG Instalações em Ilhéus"></iframe>
    </div>
  </div></section>
</Base>
<style>.page-hero { background: var(--navy); color: #fff; padding: 56px 0; } .page-hero h1 { color: #fff; }</style>
