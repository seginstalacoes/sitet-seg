---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection, render } from 'astro:content';
import { waLink } from '../../data/site.js';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos');
  return projetos.map(p => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const waMsg = `Olá! Vi o case "${p.data.title}" no site da SEG e quero um projeto parecido.`;
---
<Base title={`${p.data.title} | Projetos SEG Instalações`} description={p.data.resumo} waMsg={waMsg}>
  <section class="page-hero"><div class="wrap">
    <span class="eyebrow">{p.data.segmento} · {p.data.local}</span>
    <h1>{p.data.title}</h1>
  </div></section>
  <section class="section" style="padding-top:48px"><div class="wrap two-col">
    <div>
      <img src={p.data.foto} alt={p.data.title} style="width:100%;height:380px;object-fit:cover;border-radius:var(--radius);margin-bottom:34px" />
      <div class="prose"><Content /></div>
    </div>
    <aside>
      <div class="aside-cta">
        <p style="font-weight:700;color:#fff;margin-bottom:12px">Sistemas deste projeto</p>
        <ul class="zebra" style="margin-bottom:20px">
          {p.data.sistemas.map(s => (<li>{s}</li>))}
        </ul>
        <a class="btn btn-primary" href="/orcamento" style="width:100%">Quero um projeto assim</a>
        <a class="btn btn-ghost" href={waLink(waMsg)} rel="noopener" style="width:100%;margin-top:10px">Falar no WhatsApp</a>
      </div>
    </aside>
  </div></section>
  <CtaBand waMsg={waMsg} />
</Base>
<style>
.page-hero { background: var(--navy); color: #fff; padding: 56px 0; }
.page-hero h1 { color: #fff; max-width: 26ch; }
.two-col { display: grid; grid-template-columns: 1.6fr 1fr; gap: 44px; align-items: start; }
@media (max-width: 880px) { .two-col { grid-template-columns: 1fr; } }
aside { position: sticky; top: 90px; }
.aside-cta { border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
</style>
